NODE_ENV=production
PORT=10000

# Use your production MySQL host/database credentials.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-a-unique-strong-password
DB_NAME=your-mysql-database

# Generate a long random secret; do not reuse the development secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Exact frontend origin(s); comma-separated FRONTEND_URLS can hold additional domains.
FRONTEND_URL=https://firstshadi.netlify.app
# Comma-separated exact origins for all deployed frontend domains.
FRONTEND_URLS=https://firstshadi.netlify.app,https://firstmarriage.netlify.app

# OAuth 2.0 Web client ID from Google Cloud Console (also set as VITE_GOOGLE_CLIENT_ID on Netlify).
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# On Render, mount a persistent disk at /var/data and use this directory.
# For Hostinger, use a writable persistent directory for your Node app.
UPLOAD_DIR=/var/data/uploads

# Profile photos are stored in S3. Set credentials in the hosting dashboard, not in Git.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-profile-photo-bucket
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
# Optional: use a CloudFront/custom domain instead of the regional S3 URL.
# AWS_S3_PUBLIC_URL=https://cdn.example.com
