NODE_ENV=production
PORT=10000

# Use your production MySQL host/database credentials.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=replace-with-a-unique-strong-password
DB_NAME=your-mysql-database

# Generate a long random secret; do not reuse the development secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Exact frontend origin(s), comma-separated if there is more than one.
FRONTEND_URL=https://your-frontend-domain.example

# On Render, mount a persistent disk at /var/data and use this directory.
# For Hostinger, use a writable persistent directory for your Node app.
UPLOAD_DIR=/var/data/uploads
